{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GithubScout": {
    "PollIntervalSeconds": 120,
    "WatchlistFilePath": "watchlist.json",
    "EnableToastNotifications": true,
    "EnableKeepAwake": true,
    "MaxActivityEntries": 200
  }
}
